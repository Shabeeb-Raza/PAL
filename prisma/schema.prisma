generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id                String   @id @default(cuid())
  studentId         String   @unique
  name              String
  program           String   @default("CS")
  admissionSemester String?
  currentSemester   Int      @default(1)
  cgpa              Float    @default(0)
  totalCredits      Int      @default(0)
  earnedCredits     Int      @default(0)
  academicStatus    String   @default("active")
  attendancePct     Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments      Enrollment[]
  policyResults    PolicyResult[]
  riskPrediction   RiskPrediction?

  @@index([studentId])
  @@index([program])
}

model Course {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  creditHours  Int
  componentType String // theory, lab, combined
  program      String   @default("CS")

  enrollments Enrollment[]

  @@index([code])
  @@index([program])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  courseId    String
  semester   String
  grade      String?
  gradePoints Float?
  status     String   @default("enrolled") // enrolled, passed, failed, withdrawn

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, semester])
  @@index([studentId])
  @@index([courseId])
}

model PolicyResult {
  id          String   @id @default(cuid())
  studentId   String
  policyId    String
  outcome     String   // pass, fail, warning
  explanation String
  evaluatedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([policyId])
}

model RiskPrediction {
  id          String   @id @default(cuid())
  studentId   String   @unique
  riskTier    String   // Green, Amber, Red
  confidence  Float
  explanation String[]
  predictedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("faculty")
  createdAt DateTime @default(now())
}
